{
  "description": "sol-zcode hooks: single dispatcher script for all seven events. The script reads the event name from the stdin payload and resolves its own configuration from ~/.zcode/cli/config.json plugins.options (zero behavior when all mechanisms are off or SOL_ZCODE_AUX=1).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "sol-zcode: session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "sol-zcode: prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "sol-zcode: pre tool"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "sol-zcode: permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 30000,
            "statusMessage": "sol-zcode: post tool"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 15000,
            "statusMessage": "sol-zcode: tool failure"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/sol-hook.mjs"],
            "timeoutMs": 30000,
            "statusMessage": "sol-zcode: stop"
          }
        ]
      }
    ]
  }
}
